# Deployer wallet (no 0x prefix)
PRIVATE_KEY=your_deployer_private_key_here

# Agent wallet — separate from deployer (no 0x prefix)
AGENT_PRIVATE_KEY=your_agent_private_key_here
AGENT_METADATA_URI=https://raw.githubusercontent.com/your-org/proov/main/agent-metadata.json

# Celo — get from celoscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Web3Auth — get from dashboard.web3auth.io
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Contract addresses — fill after deploy
NEXT_PUBLIC_PROOV_CORE_ADDRESS=
NEXT_PUBLIC_SESSION_MANAGER_ADDRESS=
NEXT_PUBLIC_CIRCLE_MANAGER_ADDRESS=

# Network: 11142220 = Celo Sepolia (dev), 42220 = Celo Mainnet (prod)
NEXT_PUBLIC_CHAIN_ID=11142220

# Fill after running register-agent.ts
NEXT_PUBLIC_AGENT_ADDRESS=
