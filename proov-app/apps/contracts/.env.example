# The private key of the account to use for deployments (no 0x prefix).
# ⚠️  NEVER put real values here — use a local .env file that is gitignored.

PRIVATE_KEY=your_deployer_private_key_here

# Celoscan API key for contract verification — celoscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here

# (Optional) Set to "true" to enable the gas reporter.
REPORT_GAS=

# RPC URLs (defaults already set in hardhat.config.ts)
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org/
